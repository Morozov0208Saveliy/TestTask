<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/entryFragment">

    <fragment
        android:id="@+id/entryFragment"
        android:name="com.example.testtask.fragment.EntryFragment"
        android:label="EntryFragment"
        tools:layout="@layout/fragment_entry">
        <action
            android:id="@+id/action_entry_to_mainScreenWrapperFragment"
            app:destination="@id/mainScreenWrapperFragment"
            app:popUpToInclusive="true"
            app:popUpTo="@id/entryFragment"/>
    </fragment>

    <fragment
        android:id="@+id/mainScreenWrapperFragment"
        android:name="com.example.testtask.fragment.MainScreenWrapperFragment"
        android:label="MainScreenWrapperFragment"
        tools:layout="@layout/fragment_main_screen_wrapper" />

</navigation>